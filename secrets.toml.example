# ═══ ARAKONAK GES — Streamlit Secrets ═══
# Bu dosyayı Streamlit Cloud'da: uygulama → Settings → Secrets alanına yapıştırın.
# (Yerel test için .streamlit/secrets.toml olarak kaydedin — bu dosyayı GitHub'a KOYMAYIN.)

# Supabase kalıcı yedek (isteğe bağlı ama önerilir).
# db_url tanımlıysa her veri değişikliği otomatik Supabase'e yedeklenir,
# uygulama yeniden başlasa bile veriler korunur.
[supabase]
db_url = "postgresql://postgres:PAROLANIZ@db.xxxxxxxx.supabase.co:5432/postgres"
